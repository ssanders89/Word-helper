# Copy this file to .env for local (non-Docker) development, or set these
# as environment variables / docker-compose "environment:" entries.

# ---------------------------------------------------------------------------
# Pictures library
# ---------------------------------------------------------------------------
# Top-level folder containing one subfolder per letter (A, B, C, ...), each
# holding pictures whose name starts with that letter. The app trusts this
# structure completely -- it never checks whether a picture actually matches
# its folder's letter, that's on you to manage.
PICTURES_DIR=/pictures

# ---------------------------------------------------------------------------
# Whisper (speech-to-text) - Wyoming protocol
# ---------------------------------------------------------------------------
# Point this at your existing Whisper Wyoming service (e.g. the
# "Whisper" Home Assistant add-on / wyoming-whisper container).
# Leave WHISPER_HOST empty to disable the "spoken" input method.
WHISPER_HOST=whisper
WHISPER_PORT=10300

# ---------------------------------------------------------------------------
# Piper (text-to-speech) - Wyoming protocol
# ---------------------------------------------------------------------------
# Point this at your existing Piper Wyoming service (e.g. the "Piper"
# Home Assistant add-on / wyoming-piper container).
# Leave PIPER_HOST empty to disable the "hear the word" game mode and
# spoken hints (the app still runs fine in picture-only mode).
PIPER_HOST=piper
PIPER_PORT=10200
# Optional: a specific voice name known to your Piper install
# (e.g. en_US-lessac-medium). Leave blank to use Piper's default voice.
PIPER_VOICE=

# ---------------------------------------------------------------------------
# AI feedback (optional)
# ---------------------------------------------------------------------------
# The app works great with zero AI configuration -- it falls back to a set
# of canned, kid-friendly encouragement messages. Configure one of the
# providers below only if you'd like short, varied, AI-generated
# encouragement messages instead.
#
# AI_PROVIDER = "anthropic" | "local" | "none" (default: none)
AI_PROVIDER=none

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Any Claude model id; a small/fast one is plenty for one short sentence.
AI_MODEL=claude-haiku-4-5-20251001

# --- Local / self-hosted (any OpenAI-compatible chat completions API,
#     e.g. Ollama, LM Studio, llama.cpp server, vLLM, etc.) ---
LOCAL_AI_URL=http://ollama:11434/v1/chat/completions
LOCAL_AI_MODEL=llama3.1
LOCAL_AI_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
